# Sanity CMS
# Get these from https://sanity.io/manage → your project → Settings → API
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API token — only needed for the seed script (write access)
# Create one at https://sanity.io/manage → your project → Settings → API → Tokens
# Use "Editor" permissions for the seed script
SANITY_API_TOKEN=your_write_token_here
